# Local-only: vendor material (copyrighted) and the board's factory firmware
vendor/
backup/
*.bin
!**/test/**/*.bin

# ESP-IDF build output
build/
build-*/
managed_components/
*.elf
*.map

# Generated or secret configs; only the defaults and the example are tracked
sdkconfig*
!sdkconfig.defaults
!sdkconfig.secrets.example

# macOS / editors
.DS_Store
.vscode/
.idea/

# Local-only agent context (toolchain, doc sources, notes). Ships as
# AGENTS.local.md.example; the filled-in copy stays local.
/AGENTS.local.md
/CLAUDE.local.md

# Opt-in dev seed (Wi-Fi credentials, Ember URL) and local credentials
firmware/sdkconfig.secrets
.env
*.env
*.sha256
*.pem
*.key
*.p12

# Generated meshes (python3 enclosure/make_stl.py)
enclosure/stl/
__pycache__/

# OTA test images (firmware/tools/build_release.sh --dir build-test, copied for upload)
ota-test/
