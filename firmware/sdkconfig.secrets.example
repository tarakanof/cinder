# Opt-in dev seed only; every normal build (idf.py build, tools/build_release.sh) ignores
# this file. Copy to sdkconfig.secrets (git-ignored) and build into its own directory:
#   idf.py -B build-seed -D SDKCONFIG=build-seed/sdkconfig -D CINDER_SEED_SECRETS=1 build
# Seeds NVS namespace "cinder" with the Wi-Fi network and the Ember URL on a boot where it
# is empty or has no SSID. Never a token: pair from the Ember app (device token over USB).
# The usual path needs no seed: Improv USB provisioning, then pairing from the app.
CONFIG_CINDER_DEV_SEED=y
CONFIG_CINDER_WIFI_SSID="your-2.4GHz-ssid"
CONFIG_CINDER_WIFI_PASSWORD="your-password"
CONFIG_CINDER_EMBER_URL="http://192.168.x.y:3627"
